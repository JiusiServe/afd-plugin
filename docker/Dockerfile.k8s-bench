# Benchmark image for tools/benchmarks/kubernetes: bakes nixl + an editable
# afd-plugin install (repo sources included) into a vLLM base image, so the
# serve+bench pod can start without copying the repo in or building a venv
# at runtime. Build from the afd-plugin repo root:
#   docker build -f docker/Dockerfile.k8s-bench -t <tag> .
#
# Keep VLLM_BASE_TAG aligned with [project.optional-dependencies].vllm in
# pyproject.toml. This is a separate image from docker/Dockerfile.ci (the CI
# image); do not merge the two -- Dockerfile.ci is consumed by
# .buildkite/cuda/scripts/build-ci-image.sh and pushed to a shared ECR cache.
ARG VLLM_BASE_IMAGE=vllm/vllm-openai
ARG VLLM_BASE_TAG=v0.26.0

# deps stage: everything except the real project sources, so source-only
# changes don't invalidate the nixl/afd-plugin dependency layer.
FROM ${VLLM_BASE_IMAGE}:${VLLM_BASE_TAG} AS deps

ARG APP_DIR=/opt/afd-plugin
WORKDIR ${APP_DIR}

RUN ln -sf /usr/bin/python3 /usr/bin/python

# Placeholder package tree so editable install can register APP_DIR.
# The final stage COPY --link fills this directory with the real sources.
RUN mkdir -p afd_plugin && touch afd_plugin/__init__.py

COPY pyproject.toml setup.py uv.lock README.md LICENSE ./

# Docker build context has no .git, so setuptools-scm cannot infer a
# version; pretend one for this image's install.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AFD_BUILD_ASCEND_OPS=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM_AFD_PLUGIN=0.0.0+bench \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0+bench

# Install nixl and editable-install the project into the base image's system
# Python. Do NOT reinstall after the final COPY --link, or every source-only
# change would need to pull the heavy base image again.
RUN uv pip install --system nixl \
    && uv pip install --system --no-deps -e .

# Final stage: overlay workspace sources onto the cached deps image.
FROM deps
ARG APP_DIR=/opt/afd-plugin
WORKDIR ${APP_DIR}

COPY --link . .

# Benchmark scripts call `uv run vllm ...`, which would try to sync a uv
# project; this image has no uv project, so call the baked-in vllm directly.
RUN sed -i 's/uv run vllm/vllm/g' \
    tools/benchmarks/decode_bench_server.sh \
    tools/benchmarks/request_generator.sh

ENTRYPOINT []
