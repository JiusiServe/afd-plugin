# Minimal CI image for AFD Plugin Simple (CPU unit) tests.
# Used by .buildkite/cuda/scripts/build-ci-image.sh
FROM python:3.12-slim-bookworm

# Docker build context has no .git (see .dockerignore), so setuptools-scm
# cannot infer a version; pretend one for CI image installs.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AFD_BUILD_ASCEND_OPS=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM_AFD_PLUGIN=0.0.0+ci

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /workspace
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY afd_plugin ./afd_plugin
COPY tests ./tests
COPY csrc ./csrc

RUN uv sync --locked --group dev \
    && uv pip install -e .

ENV PATH="/workspace/.venv/bin:${PATH}"
WORKDIR /workspace
