{
  "mode": "continuous",
  "length_mix": [
    {"tokens": 512, "weight": 0.4},
    {"tokens": 2048, "weight": 0.2},
    {"tokens": 4096, "weight": 0.3},
    {"tokens": 8192, "weight": 0.1}
  ],
  "arrival": {
    "kind": "poisson",
    "qps": 8,
    "duration_s": 60,
    "warmup_s": 10,
    "seed": 1024
  },
  "scheduler": {
    "afd_policy": "current_runtime",
    "merged_policy": "current_runtime",
    "max_num_seqs": 64,
    "chunked_prefill": false,
    "afd": {
      "max_num_batched_tokens": 16384,
      "chunk_size": 16384
    },
    "merged": {
      "max_num_batched_tokens": 16384,
      "chunk_size": 16384
    }
  },
  "prefix_cache": {
    "enabled": false,
    "request_hit_rate": 0,
    "matched_prefix_ratio": 0,
    "block_size": 32,
    "lookup_fixed_ms": 0,
    "lookup_per_block_ms": 0,
    "seed": 1024
  },
  "afd": {
    "ubatch_split": "request"
  },
  "slo": {
    "ttft_limit_ms": 2000,
    "target_ratio": 0.99
  },
  "sweep": {
    "min_qps": 0.25,
    "max_qps": 64,
    "coarse_points": 10,
    "refinement_steps": 7,
    "throughput_tolerance_ratio": 0.99
  },
  "fixed_ttft_overhead_ms": 0,
  "output": {
    "include_timeline": false,
    "timeline_max_events": 20000,
    "include_requests": false
  }
}
